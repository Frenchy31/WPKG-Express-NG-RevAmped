<?xml version="1.0" encoding="UTF-8" ?>
<packages>
    <package id="all-checks" name="All check types" revision="1.2.3" priority="100" reboot="postponed" notify="true" execute="once">
        <check type="logical" condition="and">
            <check type="registry" condition="exists" path="HKLM\Software\Vendor\Key" />
            <check type="registry" condition="equals" path="HKLM\Software\Vendor\Version" value="1.2.3" />
            <check type="logical" condition="or">
                <check type="file" condition="exists" path="%ProgramFiles%\Vendor\app.exe" />
                <check type="file" condition="sizeequals" path="%ProgramFiles%\Vendor\app.exe" value="1024" />
                <check type="file" condition="versionsmallerthan" path="%ProgramFiles%\Vendor\app.exe" value="1.0" />
                <check type="logical" condition="not">
                    <check type="file" condition="versionlessorequal" path="%ProgramFiles%\Vendor\app.exe" value="1.1" />
                    <check type="file" condition="versionequalto" path="%ProgramFiles%\Vendor\app.exe" value="1.2" />
                    <check type="file" condition="versiongreaterthan" path="%ProgramFiles%\Vendor\app.exe" value="1.3" />
                </check>
            </check>
            <check type="file" condition="versiongreaterorequal" path="%ProgramFiles%\Vendor\app.exe" value="1.4" />
            <check type="logical" condition="atleast">
                <check type="execute" condition="exitcodesmallerthan" path="check.exe /a" value="1" />
                <check type="execute" condition="exitcodelessorequal" path="check.exe /b" value="2" />
            </check>
            <check type="logical" condition="atmost" />
        </check>
        <check type="execute" condition="exitcodeequalto" path="check.exe /c" value="0" />
        <check type="execute" condition="exitcodegreaterthan" path="check.exe /d" value="3" />
        <check type="execute" condition="exitcodegreaterorequal" path="check.exe /e" value="4" />
        <check type="uninstall" condition="versionsmallerthan" path="Vendor App" value="1.0" />
        <check type="uninstall" condition="versionlessorequal" path="Vendor App" value="1.1" />
        <check type="uninstall" condition="versionequalto" path="Vendor App" value="1.2" />
        <check type="uninstall" condition="versiongreaterthan" path="Vendor App" value="1.3" />
        <check type="uninstall" condition="versiongreaterorequal" path="Vendor App" value="1.4" />
        <check type="host" condition="hostname" value="room1-pc.+" />
        <check type="host" condition="os" value="Windows 10" />
        <check type="host" condition="architecture" value="x64" />
        <check type="host" condition="environment" value="FOO=bar" />
        <install cmd="msiexec /i %SOFTWARE%\all\first.msi /qn" workdir="C:\Temp" timeout="600">
            <exit code="0" />
            <exit code="3010" reboot="true" />
            <exit code="1641" reboot="delayed" />
            <exit code="any" reboot="postponed" />
        </install>
        <install cmd="msiexec /i %SOFTWARE%\all\second.msi /qn">
            <exit code="1" />
        </install>
        <downgrade cmd="msiexec /i %SOFTWARE%\all\old.msi /qn" timeout="1200" />
        <remove cmd="msiexec /x {11111111-2222-3333-4444-555555555555} /qn" />
    </package>
    <package id="7zip" name="7-Zip" revision="23.01" priority="50" reboot="false">
        <variable name="PKG_VERSION" value="23.01" />
        <check type="uninstall" condition="exists" path="7-Zip.*" />
        <install cmd='"%TEMP%\7zip\7zsetup.exe" /S' />
        <upgrade cmd='"%TEMP%\7zip\7zsetup.exe" /S' />
        <remove cmd='%ComSpec% /c "%ProgramFiles%\7-Zip\Uninstall.exe" /S' />
    </package>
    <package id="amp-quote" name="Ampersand and quote" revision="1" priority="10" reboot="false">
        <install cmd='cmd /c "echo a & echo b"' />
    </package>
    <package id="amp" name="Ampersand command" revision="1" priority="10" reboot="false">
        <install cmd="cmd /c echo a & echo b" />
    </package>
    <package id="angle" name="Angle brackets" revision="1" priority="10" reboot="false">
        <install cmd="cmd /c type foo.txt > bar.txt" />
        <remove cmd='cmd /c "type foo.txt > bar.txt"' />
    </package>
    <package id="both-quotes" name="Both quote kinds" revision="1" priority="10" reboot="false">
        <install cmd='cmd /c "echo it&#039;s done"' />
        <remove cmd="cmd /c echo it's done" />
    </package>
    <!--
    <package id="disabled-dash" name="Disabled double dash" revision="1" priority="10" reboot="false">
        <install cmd="setup.exe --silent --no-restart" />
    </package>
    -->
    <package id="accent" name="Éditeur été" revision="2.0" priority="5" reboot="false">
        <variable name="LIBELLE" value="Été &amp; hiver" />
        <install cmd='setup.exe /dir:"C:\Program Files\Été"' />
    </package>
    <package id="var-rev" name="Variable revision" revision="%PKG_VERSION%" priority="5" reboot="true" execute="always">
        <variable name="PKG_VERSION" value="4.5.6" />
        <install cmd="setup.exe /version:%PKG_VERSION%" />
    </package>
    <package id="dep-child" name="Depends on others" revision="1.0" priority="0" reboot="false">
        <depends package-id="7zip" />
        <depends package-id="all-checks" />
        <install cmd="setup.exe /q" />
    </package>
    <package id="plain" name="Plain safe commands" revision="3.1" priority="0" reboot="false">
        <install cmd="setup.exe /q" />
        <upgrade cmd="upgrade.exe /q" />
        <remove cmd="remove.exe /q" />
    </package>
</packages>