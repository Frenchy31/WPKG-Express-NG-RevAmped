# Copy to wpkg.env (install.sh does it, and fills the empty values). Change a value here, then run
# docker compose up -d (or ./install.sh again) to apply it.
DEBUG=false
# Generated by install.sh on the first install: never share it, never change it (sessions would be logged out).
SECURITY_SALT=
# http://<server name>, with :<port> when the HTTP port is not 80.
APP_FULL_BASE_URL=
# Time zone and default language of the interface (en_US or fr_FR). The datetime columns of the database
# have no time zone: changing APP_DEFAULT_TIMEZONE later shifts the dates already stored.
APP_DEFAULT_TIMEZONE=
APP_DEFAULT_LOCALE=
# Every name clients use in hosts_path, profiles_path and packages_path.
WPKG_ALLOWED_HOSTS=
DATABASE_URL=
# PHP settings read by php.ini when the container starts: no image rebuild needed.
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=16M
PHP_POST_MAX_SIZE=16M
WPKG_ADMIN_USER=admin
WPKG_XML_FORMAT=true
WPKG_XML_EXPORT_DISABLED=false
WPKG_XML_PROTECT=false
WPKG_XML_USER=wpkg
WPKG_FORCE_SSL=false
# <HOSTNAME>.xml and <HOSTNAME>.log copied by the workstations, read by the Reports page.
WPKG_REPORTS_PATH=/var/lib/wpkg/reports
# install.sh writes the hashes. By hand: docker compose --profile tools run --rm tools bin/cake hash_password '<password>'
# Keep the single quotes: the hash contains "$".
WPKG_ADMIN_PASSWORD_HASH=''
WPKG_XML_PASSWORD_HASH=''
