# Copy to wpkg.env (install.sh does it). Local development values: replace them before any shared deployment.
DEBUG=false
SECURITY_SALT=dev-only-salt-0123456789abcdef0123456789abcdef
APP_FULL_BASE_URL=http://localhost
# Every name clients use in hosts_path, profiles_path and packages_path.
WPKG_ALLOWED_HOSTS=wpkg,172.19.0.5
DATABASE_URL=mysql://wpkg:your_password@mysql/wpkg?encoding=utf8mb4
WPKG_ADMIN_USER=admin
WPKG_XML_FORMAT=true
WPKG_XML_EXPORT_DISABLED=false
WPKG_XML_PROTECT=false
WPKG_XML_USER=wpkg
WPKG_FORCE_SSL=false
# <HOSTNAME>.xml and <HOSTNAME>.log copied by the workstations, read by the Reports page.
WPKG_REPORTS_PATH=/var/lib/wpkg/reports
# Generate hashes with: docker compose --profile tools run --rm tools bin/cake hash_password '<password>'
# Keep the single quotes: the hash contains "$".
WPKG_ADMIN_PASSWORD_HASH=''
WPKG_XML_PASSWORD_HASH=''
