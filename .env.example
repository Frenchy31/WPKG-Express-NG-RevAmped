# Copy to .env (install.sh does it). Docker Compose reads this file for COMPOSE_FILE and for the
# interpolated variables of the Compose files.
#
# Compose files in use: the root file first, then one per enabled component. Remove a component to
# disable it, add services/windows-vm/compose.yaml to enable the Windows test VM. A git-ignored
# compose.local.yaml may be appended for overrides specific to this host.
COMPOSE_FILE=compose.yaml:services/wpkg/compose.yaml:services/mysql/compose.yaml:services/samba/compose.yaml:services/tools/compose.yaml

# Host port of the web interface and of the XML feeds.
WPKG_HTTP_PORT=80
